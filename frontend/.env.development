# Local `vite dev` (frontend on :5173, engine on :8001). Not loaded by
# `vite build` (production mode) -- the code's own runtime fallback derives
# same-origin URLs for that case (frontend/src/App.tsx, HomeScreen.tsx,
# hooks/useStory.ts).
VITE_API_BASE=http://localhost:8001
VITE_WS_BASE=ws://localhost:8001/ws/story
